[Desktop Entry]
Version=1.0
Name=Chromium Web Browser
Name[ru]=Браузер
GenericName=Web Browser
Exec=env BAMF_DESKTOP_FILE_HINT=/var/lib/snapd/desktop/applications/chromium_chromium.desktop /snap/bin/chromium %U
